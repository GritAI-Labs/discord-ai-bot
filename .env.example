# --- Discord ---
DISCORD_BOT_TOKEN=your-bot-token-here      # Developer Portal -> Bot -> Reset Token
BOT_NAME=GritAI Bot
BOT_COOLDOWN_SECONDS=3

# --- Brain backend ---
BOT_LLM_BACKEND=ollama                      # "ollama" (local, free) or "claude"
# Local GPU fleet (default): free, private, on-brand.
BOT_OLLAMA_URL=http://192.168.12.223:11434
BOT_OLLAMA_MODEL=qwen2.5:7b
# Optional Claude backend (only if BOT_LLM_BACKEND=claude):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
